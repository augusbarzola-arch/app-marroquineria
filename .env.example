# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marroquineria
DB_USER=postgres
DB_PASSWORD=postgres
DB_MIN_CONN=1
DB_MAX_CONN=10

# Configuración del Servidor Web
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Configuración de Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
